# TigerLite OTLP exporter
#
# Copy this file to .env.tigerlite and fill in values, or set these in your
# shell before running `docker compose up -d`. The otel-collector picks them
# up via the otlphttp/tigerlite exporter defined in
# src/otel-collector/otelcol-config-extras.yml.
#
# For local TigerLite dev (TigerLite running on the docker host):
#   TIGERLITE_OTLP_ENDPOINT=http://host.docker.internal:8080
#
# For hosted TigerLite:
#   TIGERLITE_OTLP_ENDPOINT=https://api.tigerlite.dev
#
# Get the ingest token from the TigerLite dashboard's Telemetry connect modal.

TIGERLITE_OTLP_ENDPOINT=http://host.docker.internal:8080
TIGERLITE_INGEST_TOKEN=replace-me-with-token-from-tigerlite-dashboard
